name: "easyocr"
backend: "python"

max_batch_size: 1
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [-1, -1, -1]
  }
]

output [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [-1]
  }
]

parameters: {
  key: "EXECUTION_ENV_PATH",
  value: {string_value: "/opt/triton-demo/venv"}
}
